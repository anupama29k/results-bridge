{
  "NGS_001_library_prep_input": {
    "description": "dsDNA input concentration for NGS library prep (Qubit HS)",
    "param_path": [
      "measurements",
      "concentration_ng_per_uL"
    ],
    "min": 10.0,
    "max": 100.0,
    "unit": "ng/uL",
    "regulatory": [
      "Internal QC SOP (project-defined range)"
    ]
  },
  "ELISA_001_tmb_endpoint": {
    "description": "ELISA endpoint absorbance at 450 nm (Tecan Spark). Floor from library criterion 'negative control OD < 0.1 above blank'; ceiling = reader linear range. Curve-level acceptance (R2, CV) lives in the assay definition.",
    "param_path": [
      "measurements",
      "absorbance"
    ],
    "min": 0.1,
    "max": 3.5,
    "unit": "AU",
    "regulatory": [
      "ICH Q6B",
      "robotic-assays field_01 sandwich ELISA criteria"
    ],
    "roles": {
      "blank": {
        "max": 0.1
      },
      "sample": {
        "min": 0.1,
        "max": 3.5
      }
    },
    "plate": {
      "library_assay_id": "BIO_005",
      "model": "4pl",
      "blank_subtract": false,
      "fit_includes_blank": true,
      "conc_unit": "x top standard",
      "criteria": [
        {
          "key": "standard_curve_r2",
          "type": "curve_r2",
          "min": 0.995,
          "source": "BIO_005 acceptance_criteria (prose: '>= 0.995 (4PL fit)')"
        },
        {
          "key": "curve_bottom_asymptote_od",
          "type": "fit_param",
          "param": "bottom",
          "max": 0.1,
          "unit": "AU",
          "source": "BIO_005 acceptance_criteria (prose: '< 0.10')"
        },
        {
          "key": "curve_top_asymptote_od",
          "type": "fit_param",
          "param": "top",
          "min": 1.5,
          "unit": "AU",
          "source": "BIO_005 acceptance_criteria (prose: '> 1.5')"
        },
        {
          "key": "intraplate_cv_max",
          "type": "replicate_cv_max",
          "max": 15.0,
          "unit": "%",
          "applies_to": [
            "standard",
            "sample",
            "qc"
          ],
          "source": "BIO_005 acceptance_criteria (prose: '<= 15%')"
        },
        {
          "key": "qc_sample_recovery",
          "type": "qc_recovery",
          "min": 80,
          "max": 120,
          "unit": "%",
          "source": "BIO_005 acceptance_criteria (prose: '80-120% of expected')"
        },
        {
          "key": "ppc_recovery",
          "type": "spike_recovery",
          "min": 70,
          "max": 130,
          "unit": "%",
          "source": "BIO_005 acceptance_criteria (prose: '70-130% of spike concentration')"
        }
      ],
      "flags": [
        {
          "type": "signal_above",
          "value": 3.0,
          "message": "OD450 > 3.0 (saturation) -- repeat at higher dilution (BIO_005 step 18)"
        }
      ]
    }
  },
  "NGS_002_library_fragment_size": {
    "description": "Library average fragment size (TapeStation). Range verbatim from robotic-assays field_03 AMPure post-PCR criteria.",
    "param_path": [
      "measurements",
      "average_size_bp"
    ],
    "min": 250,
    "max": 500,
    "unit": "bp",
    "regulatory": [
      "ENCODE NGS library prep standards"
    ]
  },
  "NGS_003_pooling_input": {
    "description": "dsDNA concentration acceptable for downstream pooling (Qubit HS). Range verbatim from robotic-assays field_03 Qubit quantification criteria.",
    "param_path": [
      "measurements",
      "concentration_ng_per_uL"
    ],
    "min": 0.5,
    "max": 50.0,
    "unit": "ng/uL",
    "regulatory": [
      "Illumina library QC requirements",
      "Internal QC SOP"
    ]
  },
  "PROT_001_expression_fluorescence": {
    "description": "Reporter fluorescence endpoint (BMG CLARIOstar). Plausibility gate only \u2014 the assay-level criterion is relative (signal/background >= 5x per library HTS criteria).",
    "param_path": [
      "measurements",
      "fluorescence"
    ],
    "min": 500,
    "max": 250000,
    "unit": "RFU",
    "regulatory": [
      "Internal QC SOP (instrument plausibility window)"
    ]
  },
  "PROT_002_bca_od562": {
    "description": "BCA protein assay absorbance at 562 nm. Floor from library criterion 'blank OD562 < 0.10'; ceiling = reader linear range. Curve-level acceptance (R2 >= 0.995, CV) lives in the assay definition.",
    "param_path": [
      "measurements",
      "absorbance"
    ],
    "min": 0.1,
    "max": 3.5,
    "unit": "AU",
    "regulatory": [
      "ICH Q6B",
      "USP <1057>"
    ],
    "roles": {
      "blank": {
        "max": 0.1
      },
      "standard": {
        "max": 3.5
      },
      "sample": {
        "min": 0.1,
        "max": 3.5
      },
      "qc": {
        "min": 0.1,
        "max": 3.5
      }
    },
    "plate": {
      "library_assay_id": "BIO_002",
      "model": "linear",
      "blank_subtract": true,
      "fit_includes_blank": false,
      "conc_unit": "ug/mL",
      "compare_models": [
        "quadratic",
        "4pl"
      ],
      "note": "Library prose specifies a linear curve with R2 >= 0.995. BCA is curvilinear over 31-2000 ug/mL, so alternative-model R2 is reported for information; the verdict uses the library's linear rule until the method owner changes 'model'.",
      "criteria": [
        {
          "key": "standard_curve_r2",
          "type": "curve_r2",
          "min": 0.995,
          "source": "BIO_002 acceptance_criteria (prose: '>= 0.995')"
        },
        {
          "key": "blank_od562_max",
          "type": "blank_mean_max",
          "max": 0.1,
          "unit": "AU",
          "source": "BIO_002 acceptance_criteria (prose: '< 0.10')"
        },
        {
          "key": "duplicate_cv_max",
          "type": "replicate_cv_max",
          "max": 5.0,
          "unit": "%",
          "applies_to": [
            "standard",
            "sample",
            "qc"
          ],
          "source": "BIO_002 acceptance_criteria (prose: '<= 5%')"
        },
        {
          "key": "qc_sample_recovery",
          "type": "qc_recovery",
          "min": 90,
          "max": 110,
          "unit": "%",
          "source": "BIO_002 acceptance_criteria (prose: '90-110% of expected')"
        }
      ],
      "flags": [
        {
          "type": "signal_above",
          "value": 2.0,
          "message": "OD562 > 2.0 is outside the linear range -- re-run at 1:10 dilution (BIO_002 step 13)"
        }
      ]
    }
  }
}
